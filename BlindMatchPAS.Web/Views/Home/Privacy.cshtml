@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="pas-page-header">
    <h2>Privacy Policy</h2>
    <p>How BlindMatchPAS handles your data</p>
</div>

<div class="pas-card" style="max-width:720px;">
    <p style="color:var(--pas-gray-text);font-size:0.95rem;line-height:1.75;">
        BlindMatchPAS takes the privacy of all platform users seriously.
        Any personal information collected from students, supervisors, and module leaders 
        during the project allocation process is handled with strict confidentiality and used 
        solely for the purposes of this system.
    </p>
    <hr style="border-color:var(--pas-border);margin:1.25rem 0;">
    <p style="color:var(--pas-gray-text);font-size:0.875rem;">
        For questions regarding this policy, please contact your institution's system administrator 
        or your faculty coordinator.
    </p>
</div>
