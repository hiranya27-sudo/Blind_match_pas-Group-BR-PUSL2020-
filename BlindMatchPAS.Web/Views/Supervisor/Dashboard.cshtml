@model IEnumerable<BlindMatchPAS.Core.Entities.Match>

@{
    ViewData["Title"] = "Supervisor Dashboard";
    var expertises = ViewBag.Expertises as IEnumerable<BlindMatchPAS.Core.Entities.SupervisorExpertise>;
}

<div class="pas-page-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2>Supervisor Dashboard</h2>
        <p>Manage your expertise and review matched projects</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="AddExpertise" class="btn-pas-orange">+ Add Expertise</a>
        <a asp-action="BrowseProjects" class="btn-pas-secondary">Browse Anonymous Projects</a>
    </div>
</div>

<!-- Expertise Areas -->
<div class="pas-card mb-4">
    <h5 style="font-family:'Sora',sans-serif;color:var(--pas-blue);font-weight:700;margin-bottom:1rem;">
        Your Expertise Areas
    </h5>
    @if (expertises != null && expertises.Any())
    {
        <div>
            @foreach (var item in expertises)
            {
                <span class="expertise-tag">@item.ResearchArea?.Name</span>
            }
        </div>
    }
    else
    {
        <div class="empty-state" style="padding:1.5rem 1rem;">
            <p>
                No expertise areas added yet.
                <a asp-action="AddExpertise" style="color:var(--pas-blue-mid);font-weight:600;text-decoration:none;">
                    Add one now →
                </a>
            </p>
        </div>
    }
</div>

<!-- Matches Table -->
<div class="pas-card">
    <h5 style="font-family:'Sora',sans-serif;color:var(--pas-blue);font-weight:700;margin-bottom:1.1rem;">
        Your Matches
    </h5>
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="pas-table">
                <thead>
                    <tr>
                        <th>Project Title</th>
                        <th>Research Area</th>
                        <th>Status</th>
                        <th>Student</th>
                        <th style="width:140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in Model)
                    {
                        <tr>
                            <td style="font-weight:500;">@match.Project?.Title</td>
                            <td>@match.Project?.ResearchArea?.Name</td>
                            <td>
                                @{
                                    var mStatus = match.Status.ToString().ToLower();
                                    var mBadge = mStatus switch
                                    {
                                        "pending" => "badge-pending",
                                        "matched" => "badge-matched",
                                        "confirmed" => "badge-confirmed",
                                        "withdrawn" => "badge-withdrawn",
                                        "interested" => "badge-interested",
                                        _ => "badge-read"
                                    };
                                }
                                <span class="badge-status @mBadge">@match.Status</span>
                            </td>
                            <td>
                                @if (match.IdentityRevealed)
                                {
                                    <div style="font-size:0.88rem;">
                                        <div style="font-weight:600;">@match.Project?.Student?.FullName</div>
                                        <div style="color:var(--pas-gray-text);font-size:0.8rem;">@match.Project?.Student?.Email</div>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--pas-gray-text);font-size:0.85rem;font-style:italic;">Hidden</span>
                                }
                            </td>
                            <td>
                                @if (match.Status == BlindMatchPAS.Core.Enums.MatchStatus.Interested)
                                {
                                    <form asp-action="ConfirmMatch" asp-route-matchId="@match.Id" method="post">
                                        <button type="submit" class="btn-pas-primary"
                                                style="font-size:0.8rem;padding:0.35rem 0.9rem;">
                                            Confirm Match
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🔗</div>
            <p>No matches yet. Browse anonymous projects to express interest.</p>
            <a asp-action="BrowseProjects" class="btn-pas-secondary"
                   style="display:inline-block;margin-top:1rem;">
                Browse Projects
            </a>
        </div>
    }
</div>
