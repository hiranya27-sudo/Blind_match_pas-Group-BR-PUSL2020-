@model BlindMatchPAS.Web.ViewModels.SupervisorExpertiseViewModel

@{
    ViewData["Title"] = "Add Expertise";
}

<h2>Add Expertise</h2>

<form asp-action="AddExpertise" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ResearchAreaId"></label>
        <select asp-for="ResearchAreaId" class="form-control">
            <option value="">-- Select Research Area --</option>
            @foreach (var area in ViewBag.ResearchAreas)
            {
                <option value="@area.Id">@area.Name</option>
            }
        </select>
        <span asp-validation-for="ResearchAreaId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}