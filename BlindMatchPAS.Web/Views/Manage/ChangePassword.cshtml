@model BlindMatchPAS.Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="pas-page-header">
    <h2>Change Password</h2>
    <p>Update your account password</p>
</div>

@if (ViewBag.StatusMessage != null)
{
    <div class="alert-pas-info" style="max-width:520px;">
        ✓ @ViewBag.StatusMessage
    </div>
}

<div class="pas-card" style="max-width:520px;">
    <form asp-action="ChangePassword" method="post">
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert-pas-error">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">Current Password</label>
            <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:0.82rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.82rem;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="font-size:0.82rem;"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-pas-orange">Change Password</button>
            <a asp-action="Index" class="btn-pas-secondary">Back to Account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
