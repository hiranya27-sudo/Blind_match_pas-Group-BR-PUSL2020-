@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="pas-card text-center" style="padding:3rem 2rem;">
            <div style="font-size:3rem;margin-bottom:1rem;">⚠️</div>
            <h1 style="font-family:'Sora',sans-serif;color:var(--pas-danger);font-size:1.6rem;font-weight:700;margin-bottom:0.5rem;">
                Something went wrong
            </h1>
            <p style="color:var(--pas-gray-text);font-size:0.95rem;margin-bottom:1.5rem;">
                An error occurred while processing your request. Please try again or return home.
            </p>

            @if (Model.ShowRequestId)
            {
                <div style="background:var(--pas-gray-bg);border:1px solid var(--pas-border);
                    border-radius:8px;padding:0.75rem 1rem;margin-bottom:1.5rem;text-align:left;">
                    <span style="font-size:0.8rem;color:var(--pas-gray-text);font-weight:600;">REQUEST ID</span><br />
                    <code style="font-size:0.85rem;color:var(--pas-blue);">@Model.RequestId</code>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn-pas-primary" style="padding:0.6rem 1.6rem;">
                Return Home
            </a>
        </div>
    </div>
</div>
