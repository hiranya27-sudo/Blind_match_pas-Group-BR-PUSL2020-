@model BlindMatchPAS.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="pas-card mt-4">
            <div class="text-center mb-4">
                <div style="display:inline-flex;align-items:center;justify-content:center;
                            width:52px;height:52px;background:var(--pas-blue);
                            border-radius:12px;margin-bottom:1rem;">
                    <svg width="26" height="26" fill="none" viewBox="0 0 24 24">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z" fill="white" />
                    </svg>
                </div>
                <div style="font-family:'Sora',sans-serif;font-size:1.4rem;font-weight:700;color:var(--pas-blue);">
                    Forgot Password?
                </div>
                <p style="color:var(--pas-gray-text);font-size:0.875rem;margin-top:0.3rem;">
                    Enter your email and we'll generate a reset link
                </p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert-pas-info mb-3">
                    ✓ @ViewBag.Message
                </div>
            }

            @if (ViewBag.ResetLink != null)
            {
                <div style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;
                                padding:0.85rem 1rem;margin-bottom:1.25rem;font-size:0.875rem;">
                    <div style="font-weight:700;color:var(--pas-orange);margin-bottom:0.4rem;">
                        Demo Reset Link
                    </div>
                    <a href="@ViewBag.ResetLink"
                       style="color:var(--pas-blue-mid);word-break:break-all;font-size:0.8rem;">
                        @ViewBag.ResetLink
                    </a>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert-pas-error">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <button type="submit" class="btn-pas-orange w-100"
                        style="padding:0.65rem;font-size:0.95rem;text-align:center;">
                    Generate Reset Link
                </button>
            </form>

            <div class="text-center mt-3" style="font-size:0.875rem;color:var(--pas-gray-text);">
                Remember your password?
                <a asp-controller="Account" asp-action="Login"
                   style="color:var(--pas-blue-mid);font-weight:600;text-decoration:none;">
                    Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
