@model BlindMatchPAS.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="pas-card mt-4">
            <div class="text-center mb-4">
                <div style="display:inline-flex;align-items:center;justify-content:center;
                    width:52px;height:52px;background:var(--pas-orange);
                    border-radius:12px;margin-bottom:1rem;">
                    <svg width="26" height="26" fill="none" viewBox="0 0 24 24">
                        <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="white" />
                    </svg>
                </div>
                <div style="font-family:'Sora',sans-serif;font-size:1.5rem;font-weight:700;color:var(--pas-blue);">Create account</div>
                <p style="color:var(--pas-gray-text);font-size:0.9rem;margin-top:0.3rem;">Join BlindMatchPAS to get started</p>
            </div>

            <form asp-action="Register" method="post">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert-pas-error">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="John Smith" />
                    <span asp-validation-for="FullName" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-control form-select">
                        <option value="">-- Select your role --</option>
                        @foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <button type="submit" class="btn-pas-orange w-100" style="padding:0.65rem;font-size:0.95rem;text-align:center;">
                    Create Account
                </button>
            </form>

            <div class="text-center mt-3" style="font-size:0.875rem;color:var(--pas-gray-text);">
                Already have an account?
                <a asp-controller="Account" asp-action="Login"
                   style="color:var(--pas-blue-mid);font-weight:600;text-decoration:none;">Sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
