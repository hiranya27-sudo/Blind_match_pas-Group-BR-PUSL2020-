@model BlindMatchPAS.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="pas-card mt-4">
            <div class="text-center mb-4">
                <div style="display:inline-flex;align-items:center;justify-content:center;
                            width:52px;height:52px;background:var(--pas-orange);
                            border-radius:12px;margin-bottom:1rem;">
                    <svg width="26" height="26" fill="none" viewBox="0 0 24 24">
                        <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" fill="white" />
                    </svg>
                </div>
                <div style="font-family:'Sora',sans-serif;font-size:1.4rem;font-weight:700;color:var(--pas-blue);">
                    Reset Password
                </div>
                <p style="color:var(--pas-gray-text);font-size:0.875rem;margin-top:0.3rem;">
                    Enter your new password below
                </p>
            </div>

            <form asp-action="ResetPassword" method="post">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert-pas-error">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">New Password</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.82rem;"></span>
                </div>

                <button type="submit" class="btn-pas-orange w-100"
                        style="padding:0.65rem;font-size:0.95rem;text-align:center;">
                    Reset Password
                </button>
            </form>

            <div class="text-center mt-3" style="font-size:0.875rem;color:var(--pas-gray-text);">
                <a asp-controller="Account" asp-action="Login"
                   style="color:var(--pas-blue-mid);font-weight:600;text-decoration:none;">
                    Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
