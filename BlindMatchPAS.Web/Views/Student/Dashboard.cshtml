@model IEnumerable<BlindMatchPAS.Core.Entities.Project>

@{
    ViewData["Title"] = "Student Dashboard";
}

<h2>Student Dashboard</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Submit New Proposal</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Research Area</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Title</td>
                <td>@project.ResearchArea?.Name</td>
                <td>@project.Status</td>
                <td>@project.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (project.Status == BlindMatchPAS.Core.Enums.ProjectStatus.Pending)
                    {
                        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-warning btn-sm">Edit</a>

                        <form asp-action="Withdraw" asp-route-id="@project.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Withdraw</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>