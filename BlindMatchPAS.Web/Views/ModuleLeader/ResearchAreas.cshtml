@model IEnumerable<BlindMatchPAS.Core.Entities.ResearchArea>

@{
    ViewData["Title"] = "Research Areas";
}

<div class="pas-page-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h2>Research Areas</h2>
        <p>Manage the research areas available for project allocation</p>
    </div>
    <a asp-action="CreateResearchArea" class="btn-pas-orange">+ Add Research Area</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert-pas-error">
        <strong>Error:</strong> @TempData["Error"]
    </div>
}

<div class="pas-card">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="pas-table">
                <thead>
                    <tr>
                        <th>Research Area Name</th>
                        <th style="width:120px;text-align:right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var area in Model)
                    {
                        <tr>
                            <td style="font-weight:500;">@area.Name</td>
                            <td style="text-align:right;">
                                <form asp-action="DeleteResearchArea" asp-route-id="@area.Id"
                                      method="post" style="display:inline;">
                                    <button type="submit" class="btn-pas-danger"
                                            style="font-size:0.8rem;padding:0.35rem 0.85rem;"
                                            onclick="return confirm('Delete this research area?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">🏷️</div>
            <p>No research areas added yet. Add one to get started.</p>
        </div>
    }
</div>
